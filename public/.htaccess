### AutoSSL-Satellite Don't Edit Below This Line ###
<IfModule mod_rewrite.c>
	RewriteEngine On
	# Force HTTPS
	RewriteCond %{HTTPS} off
	RewriteCond %{HTTP:X-Forwarded-SSL} !on
	RewriteRule ^(.*)$ "https://%{HTTP_HOST}%{REQUEST_URI}" [R=301,L]
</IfModule>
### AutoSSL-Satellite Don't Edit Above This Line ###

# jonnyrosero.com: static Next.js export on Namecheap (Apache)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www -> apex (HTTPS itself is forced by the AutoSSL block above)
  RewriteCond %{HTTP_HOST} ^www\.jonnyrosero\.com$ [NC]
  RewriteRule ^ https://jonnyrosero.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change, so cache them for a year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
